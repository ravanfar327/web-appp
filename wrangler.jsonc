{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f1ab47cc-8adc-40e9-aa38-2e6b1c8f1126","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "383f6e69086c4acfa4b1aea47476d2d9" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
